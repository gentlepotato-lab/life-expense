# backend/.env 의 예시. 실제 .env 는 추적하지 않는다.
# 이 파일을 .env 로 복사한 뒤 값을 채울 것.

### PostgreSQL
# 네이티브 실행이므로 127.0.0.1 (컨테이너가 5432 를 호스트에 공개)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gp-lab
DB_USER=postgres
DB_PASS=

# 스키마는 life_expense — 코드에 명시되어 있다 (app/deps.py, 각 라우터의 raw SQL)

# SQL 전문 로깅. 1 이면 켜짐, 기본 꺼짐
DB_ECHO=0

### NAVER 지도 (현재 미사용 — 라우터 제거됨. 프론트 타입 선언만 남아 있음)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

### 공공데이터포털 특일 정보 (KASI) — 공휴일 동기화 잡에서 사용
KASI_API_KEY=

### 금융결제원 오픈API: 오픈뱅킹
OPENBANKING_CLIENT_ID=
OPENBANKING_CLIENT_SECRET=
OPENBANKING_REDIRECT_URI=
OPENBANKING_BASE_URL=https://openapi.openbanking.or.kr
# CRYPTO_KEY=

