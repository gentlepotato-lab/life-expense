# frontend/.env 의 예시. 실제 .env 는 추적하지 않는다.
# 이 파일을 .env 로 복사한 뒤 값을 채울 것.

# Kakao Maps JavaScript 키
#   앱 설정 → 앱 키 → JavaScript 키
#   접속 origin 을 [JavaScript SDK 도메인] 에 등록해야 동작한다 (README 참고)
VITE_KAKAO_MAP_KEY=

# NAVER 지도 (현재 미사용)
VITE_NAVER_CLIENT_ID=

# 포트 오버라이드 (선택). 기본값은 vite.config.ts 에 있음
# VITE_BACKEND_PORT=18101
# VITE_DEV_PORT=28101
